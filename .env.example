# Copier ce fichier vers .env et renseigner les valeurs.
# .env n'est jamais versionne.
# Syntaxe de surcharge de la configuration .NET : Section__Cle

# Environnement d'execution et adresse d'ecoute
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080

# Base de donnees par defaut : SQLite (fichier cree au premier lancement)
Database__Provider=Sqlite
ConnectionStrings__Default=Data Source=norlys.db

# Exemple PostgreSQL : decommenter et adapter
# Database__Provider=Postgres
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=norlys;Username=norlys;Password=changeme
